<Window x:Class="CatalogProduse.ModificaExercitiuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatalogProduse"
        mc:Ignorable="d"
        Title="ModificaExercitiuWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,10">
            <TextBlock Text="Alege exercițiul:"/>
            <ComboBox x:Name="comboExercitii"
                      SelectionChanged="comboExercitii_SelectionChanged"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="Serii:"/>
            <TextBox x:Name="txtSerii" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10">
            <TextBlock Text="Repetări:"/>
            <TextBox x:Name="txtRepetari" />
        </StackPanel>

        <Button Grid.Row="3" Content="Salvează"
                Width="100" HorizontalAlignment="Center"
                Margin="0,15" Click="BtnSalveaza_Click"/>
    </Grid>
</Window>
