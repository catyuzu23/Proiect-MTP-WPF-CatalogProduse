<Window x:Class="CatalogProduse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatalogProduse"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Menubar rezervat -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Meniu-->
        <StackPanel Background="#2e2e2e" Grid.Column="0">
            <TextBlock Text="MENIU" Foreground="White" FontWeight="Bold" TextAlignment="Center"
                       FontSize="16" Margin="10"/>

            <Button Content="Adaugă exercițiu" FontWeight="Bold" Width="150" Height="30" Margin="0,0,0,10" Click="BtnAdaugaExercitiu_Click"/>

            <TextBlock Text="Caută exercițiu:"
           Foreground="White"
                       TextAlignment="Center"
                       
           FontWeight="Bold"
           Margin="0,0,0,5"/>

            <TextBox x:Name="txtCautare"
                      TextAlignment="Center"
                     VerticalContentAlignment="Center"
         Width="150"
         Height="25"
         Margin="0,0,0,20"
         TextChanged="txtCautare_TextChanged"/>

            <Button Content="Modifică exercițiu"
        FontWeight="Bold"
        Width="150"
        Height="30"
        Margin="0,0,0,10"
        Click="BtnModificaExercitiu_Click"/>

            <Button Content="Șterge exercițiu"
        FontWeight="Bold"
        Width="150"
        Height="30"
        Margin="0,0,0,10"
        Click="BtnStergeExercitiu_Click"/>





            <Button Content="Ieșire"
        Click="BtnIesire_Click" Width="150" Height="30" Margin="0,0,0,10"
        Padding="5"
        Background="#ff0a3f"
                    FontWeight="Bold"
        Foreground="White"
        BorderBrush="#555"
        BorderThickness="1"/>

        </StackPanel>

        <!-- Zona principală cu date -->
        <Grid Grid.Column="1" Margin="10">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Secțiunile Drag & Drop -->
            </Grid.RowDefinitions>
            
            <DataGrid Name="dataGridExercitii"
          AutoGenerateColumns="True"
          IsReadOnly="True"
          Margin="0,10,0,0" Grid.Row="0"  PreviewMouseLeftButtonDown="DataGridExercitii_PreviewMouseLeftButtonDown"/>

            <StackPanel Margin="0,20,0,0" Grid.Row="1">
                <TextBlock Text="Organizează exercițiile (Drag&amp;Drop) (dublu click = stergere)" 
               FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PUSH -->
                    <StackPanel Grid.Column="0" AllowDrop="True" Drop="Push_Drop" Background="#f2f2f2" Margin="5" >
                        <TextBlock Text="Push" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <ListBox x:Name="listPush" Height="200" MouseDoubleClick="ListPush_MouseDoubleClick"/>
                    </StackPanel>

                    <!-- PULL -->
                    <StackPanel Grid.Column="1" AllowDrop="True" Drop="Pull_Drop" Background="#f2f2f2" Margin="5" >
                        <TextBlock Text="Pull" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                        <ListBox x:Name="listPull" Height="200" MouseDoubleClick="ListPull_MouseDoubleClick"/>
                    </StackPanel>

                    <!-- LEGS -->
                    <StackPanel Grid.Column="2" AllowDrop="True" Drop="Legs_Drop" Background="#f2f2f2" Margin="5" >
                        <TextBlock Text="Legs" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                        <ListBox x:Name="listLegs" Height="200" MouseDoubleClick="ListLegs_MouseDoubleClick"/>
                    </StackPanel>
                </Grid>
            </StackPanel>


        </Grid>
    </Grid>
</Window>
