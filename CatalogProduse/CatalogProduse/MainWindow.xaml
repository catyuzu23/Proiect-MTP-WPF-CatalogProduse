<Window x:Class="CatalogProduse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatalogProduse"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Menubar rezervat -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Meniu-->
        <StackPanel Background="#2e2e2e" Grid.Column="0">
            <TextBlock Text="MENIU" Foreground="White" FontWeight="Bold" TextAlignment="Center"
                       FontSize="16" Margin="10"/>

            <Button Content="Adaugă exercițiu" FontWeight="Bold" Width="150" Height="30" Margin="0,0,0,10" Click="BtnAdaugaExercitiu_Click"/>

            <TextBlock Text="Caută exercițiu:"
           Foreground="White"
                       TextAlignment="Center"
                       
           FontWeight="Bold"
           Margin="0,0,0,5"/>

            <TextBox x:Name="txtCautare"
                      TextAlignment="Center"
                     VerticalContentAlignment="Center"
         Width="150"
         Height="25"
         Margin="0,0,0,20"
         TextChanged="txtCautare_TextChanged"/>

            <Button Content="Modifică exercițiu"
        FontWeight="Bold"
        Width="150"
        Height="30"
        Margin="0,0,0,10"
        Click="BtnModificaExercitiu_Click"/>

            <Button Content="Șterge exercițiu"
        FontWeight="Bold"
        Width="150"
        Height="30"
        Margin="0,0,0,10"
        Click="BtnStergeExercitiu_Click"/>





            <Button Content="Ieșire"
        Click="BtnIesire_Click" Width="150" Height="30" Margin="0,0,0,10"
        Padding="5"
        Background="#ff0a3f"
                    FontWeight="Bold"
        Foreground="White"
        BorderBrush="#555"
        BorderThickness="1"/>

        </StackPanel>

        <!-- Zona principală cu date -->
        <Grid Grid.Column="1" Margin="10">
            <DataGrid Name="dataGridExercitii"
          AutoGenerateColumns="True"
          IsReadOnly="True"
          Margin="0,10,0,0"/>


        </Grid>
    </Grid>
</Window>
